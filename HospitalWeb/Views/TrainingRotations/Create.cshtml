@model HospitalWeb.Models.TrainingRotation

@{
    ViewData["Title"] = "إضافة تدريب";
}


<h1>
    إضافة تدريب للطبيب
</h1>

<hr />


<div class="row">

    <div class="col-md-6">


        <form asp-action="Create">


            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>



            <!-- الطبيب -->

            <div class="form-group mb-3">

                <label asp-for="DoctorId">
                    الطبيب
                </label>


                <select asp-for="DoctorId"
                        class="form-control"
                        asp-items="ViewBag.DoctorId">

                    <option value="">
                        اختر الطبيب
                    </option>

                </select>


                <span asp-validation-for="DoctorId"
                      class="text-danger">
                </span>


            </div>





            <!-- القسم -->

            <div class="form-group mb-3">

                <label asp-for="DepartmentId">
                    القسم
                </label>


                <select asp-for="DepartmentId"
                        class="form-control"
                        asp-items="ViewBag.DepartmentId"
                        id="DepartmentId">


                    <option value="">
                        اختر القسم
                    </option>


                </select>


                <span asp-validation-for="DepartmentId"
                      class="text-danger">
                </span>


            </div>





            <!-- بداية التدريب -->

            <div class="form-group mb-3">


                <label>
                    بداية التدريب
                </label>


                <input type="text"
                       id="StartDate"
                       class="form-control"
                       placeholder="يوم/شهر/سنة"
                       autocomplete="off" />


                <input type="hidden"
                       asp-for="StartDate"
                       id="StartDateValue" />


                <span asp-validation-for="StartDate"
                      class="text-danger">
                </span>


            </div>






            <!-- نهاية التدريب -->

            <div class="form-group mb-3">


                <label>
                    نهاية التدريب
                </label>


                <input type="text"
                       id="EndDate"
                       class="form-control"
                       readonly />


                <input type="hidden"
                       asp-for="EndDate"
                       id="EndDateValue" />


                <span asp-validation-for="EndDate"
                      class="text-danger">
                </span>


            </div>







            <div class="mt-3">


                <input type="submit"
                       value="حفظ"
                       class="btn btn-primary" />


                <a asp-action="Index"
                   class="btn btn-secondary">

                    رجوع

                </a>


            </div>



        </form>


    </div>

</div>






@section Scripts {


    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }



    <script>


        function formatDate(date)
        {

            let day =
                String(date.getDate())
                .padStart(2,'0');


            let month =
                String(date.getMonth()+1)
                .padStart(2,'0');


            let year =
                date.getFullYear();



            return day + "/" + month + "/" + year;

        }




        function convertToDate(value)
        {

            let parts =
                value.split("/");


            if(parts.length !== 3)
                return null;



            return new Date(
                parseInt(parts[2]),
                parseInt(parts[1])-1,
                parseInt(parts[0])
            );

        }





        function saveDate(date)
        {

            let year =
                date.getFullYear();


            let month =
                String(date.getMonth()+1)
                .padStart(2,'0');


            let day =
                String(date.getDate())
                .padStart(2,'0');



            return year + "-" + month + "-" + day;

        }





        function calculateEndDate()
        {


        let department =
            document.getElementById("DepartmentId");


        let startText =
            document.getElementById("StartDate").value;



        let startDate =
            convertToDate(startText);



        if(!startDate || department.value === "")
        {
            return;
        }




        let name =
            department.options[
                department.selectedIndex
            ].text;



        let months = 0;



        switch(name)
        {

        case "الجراحة":
        case "الباطني":

            months = 3;

        break;



        case "النسائية":
        case "الأطفال":

            months = 2;

        break;



        case "الطوارئ":
        case "الاختياري":

            months = 1;

        break;


        }





        let endDate =
            new Date(startDate);



        endDate.setMonth(
            endDate.getMonth()+months
        );



        endDate.setDate(
            endDate.getDate()-1
        );





        document.getElementById("EndDate").value =
            formatDate(endDate);




        document.getElementById("StartDateValue").value =
            saveDate(startDate);



        document.getElementById("EndDateValue").value =
            saveDate(endDate);



        }





        document
        .getElementById("DepartmentId")
        .addEventListener(
            "change",
            calculateEndDate
        );



        document
        .getElementById("StartDate")
        .addEventListener(
            "input",
            calculateEndDate
        );



    </script>


}