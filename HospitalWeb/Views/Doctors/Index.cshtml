@model IEnumerable<HospitalWeb.Models.Doctor>

@{
    ViewData["Title"] = "الأطباء";

    var doctors = Model ?? Enumerable.Empty<HospitalWeb.Models.Doctor>();

    var warningDays =
        ViewBag.WarningDays as Dictionary<int, int>
        ?? new Dictionary<int, int>();


    var doctorsCount = ViewBag.DoctorsCount ?? 0;
    var departmentsCount = ViewBag.DepartmentsCount ?? 0;
    var trainingCount = ViewBag.TrainingCount ?? 0;


    var currentDepartments =
        ViewBag.CurrentDepartments;
}


<div class="container-fluid mt-3" dir="rtl">


    <!-- شعار المستشفى + صورة المستخدم -->

    <div class="d-flex justify-content-center align-items-center gap-4 mb-3">

        <!-- شعار المستشفى -->
        <img src="~/images/OIP.webp"
             class="hospital-logo" />


        <!-- الصورة الشخصية -->
        <img src="~/images/sandoqa.jpg"
             class="personal-logo" />

    </div>



    <h1 class="text-center text-primary mb-4">
        🏥 نظام تدريب الأطباء
    </h1>




    <!-- بطاقات الإحصائيات -->

    <div class="row g-3 mb-4">


        <div class="col-md-4">

            <div class="card shadow stat-card text-center">

                <div class="card-body">

                    <h2>👨‍⚕️</h2>

                    <h5>
                        عدد الأطباء
                    </h5>

                    <h2 class="text-primary">
                        @doctorsCount
                    </h2>

                </div>

            </div>

        </div>




        <div class="col-md-4">

            <div class="card shadow stat-card text-center">

                <div class="card-body">

                    <h2>🏥</h2>

                    <h5>
                        عدد الأقسام
                    </h5>

                    <h2 class="text-success">
                        @departmentsCount
                    </h2>

                </div>

            </div>

        </div>




        <div class="col-md-4">

            <div class="card shadow stat-card text-center">

                <div class="card-body">

                    <h2>📚</h2>

                    <h5>
                        عدد التدريبات
                    </h5>

                    <h2 class="text-danger">
                        @trainingCount
                    </h2>

                </div>

            </div>

        </div>


    </div>





    <!-- الرسم البياني للأطباء الموجودين حاليا -->

    <div class="card shadow mb-4">


        <div class="card-header bg-primary text-white text-center">

            👨‍⚕️ الأطباء الموجودون حالياً في الأقسام

        </div>


        <div class="card-body">


            <canvas id="departmentChart"
                    style="max-height:350px;">
            </canvas>


        </div>


    </div>





    <h5 class="text-center text-secondary">

        عدد الأطباء:

        <span id="resultCount">

            @doctors.Count()

        </span>

    </h5>




@if (warningDays.Any())
{

        <div class="alert alert-danger text-center shadow">

            ⚠️ يوجد
            @warningDays.Count
            طبيب قريب من انتهاء الروتيشن

        </div>

}





    <!-- البحث والأزرار -->

    <div class="row mb-3">


        <div class="col-md-6 mb-2">


            <div class="input-group">


                <input type="text"
                       id="doctorSearch"
                       class="form-control"
                       placeholder="🔍 ابحث باسم الطبيب أو الرقم..." />


                <button id="clearSearch"
                        class="btn btn-secondary">

                    مسح

                </button>


            </div>


        </div>



        <div class="col-md-6 text-center">


            <a asp-action="Create"
               class="btn btn-success m-1">

                ➕ إضافة طبيب

            </a>
            

            <a asp-controller="Backup"
               asp-action="Download"
               class="btn btn-primary m-1">

                📥 نسخة احتياطية

            </a>
            <button id="voiceButton"
                    class="btn btn-danger m-1">
                🎤 أمر صوتي
            </button>

            <div id="voiceResult"
                 class="alert alert-info text-center mt-2"
                 style="display:none;">
            </div>

            <a asp-controller="Import"
               asp-action="Access"
               class="btn btn-dark m-1">

                📂 استيراد Access

            </a>


        </div>


    </div>
    <!-- جدول الأطباء -->

    <div class="table-responsive shadow-sm">


        <table class="table table-bordered table-striped text-center align-middle">


            <thead class="table-dark">

                <tr>

                    <th>الصورة</th>
                    <th>الاسم</th>
                    <th>رقم الطبيب</th>
                    <th>الجامعة</th>
                    <th>سنة التخرج</th>
                    <th>الهاتف</th>
                    <th>التنبيه</th>
                    <th>التدريبات</th>
                    <th>الإجراءات</th>

                </tr>

            </thead>


            <tbody>


                @foreach (var item in doctors)
                {

                    warningDays.TryGetValue(item.Id, out int days);


                    var alertClass = days switch
                    {
                        1 => "danger-blink",
                        2 => "orange-blink",
                        3 => "yellow-blink",
                        4 => "blue-blink",
                        5 => "green-blink",
                        _ => ""
                    };


                    <tr class="@alertClass doctor-item"
                        data-name="@item.الاسم.ToLower()"
                        data-phone="@item.Phone"
                        data-number="@item.رقم_الطبيب">


                        <td>

                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@item.ImagePath"
                                     class="doctor-img" />
                            }
                            else
                            {
                                <span class="text-muted">
                                    لا توجد صورة
                                </span>
                            }

                        </td>



                        <td>
                            @item.الاسم
                        </td>



                        <td>
                            @item.رقم_الطبيب
                        </td>



                        <td>
                            @item.الجامعة
                        </td>



                        <td>
                            @item.سنة_التخرج
                        </td>



                        <td>
                            @item.Phone
                        </td>



                        <td>

                            @if (days > 0)
                            {
                                <span class="badge bg-danger">
                                    باقي @days يوم
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    طبيعي
                                </span>
                            }

                        </td>



                        <td>

                            @if (item.TrainingRotations != null &&
                                                    item.TrainingRotations.Any())
                            {
                                <span class="badge bg-primary">

                                    @item.TrainingRotations.Count تدريب

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">

                                    لا يوجد

                                </span>
                            }

                        </td>



                        <td>


                            <div class="d-flex flex-wrap justify-content-center gap-1">


                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">
                                    ملف
                                </a>


                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                    تعديل
                                </a>


                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">
                                    حذف
                                </a>


                                <a asp-action="TrainingNotice"
                                   asp-route-id="@item.Id"
                                   class="btn btn-primary btn-sm">
                                    📄 إشعار
                                </a>


                                <a asp-action="InternshipFinish"
                                   asp-route-id="@item.Id"
                                   class="btn btn-success btn-sm">
                                    📄 إنهاء
                                </a>


                                <a asp-action="DepartmentAssignment"
                                   asp-route-id="@item.Id"
                                   class="btn btn-secondary btn-sm">
                                    📄 تحديد قسم
                                </a>


                            </div>


                        </td>


                    </tr>

                }


            </tbody>

        </table>


    </div>





    <style>


        body {
            overflow-x: hidden;
        }



        .hospital-logo {
            width: 190px !important;
            height: 190px !important;
            object-fit: contain;
        }


        .personal-logo {
            width: 95px;
            height: 95px;
            object-fit: cover;
            border-radius: 50%;
        }

        .stat-card {
            border-radius: 20px;
            transition: .3s;
        }



            .stat-card:hover {
                transform: translateY(-5px);
            }



        .doctor-img {
            width: 45px;
            height: 45px;
            object-fit: cover;
            border-radius: 50%;
        }



        /* التنبيهات */

        tr.danger-blink td {
            animation: redBlink 1s infinite;
        }


        tr.orange-blink td {
            animation: orangeBlink 1s infinite;
        }


        tr.yellow-blink td {
            animation: yellowBlink 1s infinite;
        }


        tr.blue-blink td {
            animation: blueBlink 1s infinite;
        }


        tr.green-blink td {
            animation: greenBlink 1s infinite;
        }



        @@keyframes redBlink {

            0%, 100% {
                background: red;
                color: white;
            }

            50% {
                background: white;
                color: black;
            }
        }



        @@keyframes orangeBlink {

            0%, 100% {
                background: #ff9900;
            }

            50% {
                background: white;
            }
        }



        @@keyframes yellowBlink {

            0%, 100% {
                background: #ffff66;
            }

            50% {
                background: white;
            }
        }



        @@keyframes blueBlink {

            0%, 100% {
                background: #3399ff;
                color: white;
            }

            50% {
                background: white;
                color: black;
            }
        }



        @@keyframes greenBlink {

            0%, 100% {
                background: #33cc66;
                color: white;
            }

            50% {
                background: white;
                color: black;
            }
        }



        @@media(max-width:768px) {

            .table {
                font-size: 12px;
            }


            .btn-sm {
                font-size: 11px;
                padding: 3px;
            }
        }

    </style>





    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <script>


        // الرسم البياني

        const departmentLabels = [

        @foreach (var item in ViewBag.CurrentDepartments)
        {
                @Html.Raw($"'{item.Department}',")
        }

        ];


        const departmentCounts = [

        @foreach (var item in ViewBag.CurrentDepartments)
        {
                @Html.Raw($"{item.Count},")
        }

        ];



               new Chart(
        document.getElementById('departmentChart'),
        {

        type:'bar',

        data:{

        labels:departmentLabels,

        datasets:[{

        label:'الأطباء الحاليين',

        data:departmentCounts

        }]

        },


        options:{

        responsive:true,


        onClick:function(event, elements)
        {

            if(elements.length > 0)
            {

                let index = elements[0].index;


                let departmentName =
                departmentLabels[index];


                   window.location.assign(
        '/Doctors/DepartmentDoctors?name='
        + encodeURIComponent(departmentName)
        );
            }

        },


        scales:{

        y:{

        beginAtZero:true,

        ticks:{

        precision:0

        }

        }

        }

        }

        });



        // البحث


        const searchBox =
        document.getElementById("doctorSearch");


        const clearButton =
        document.getElementById("clearSearch");


        const doctors =
        document.querySelectorAll(".doctor-item");


        const resultCount =
        document.getElementById("resultCount");



        searchBox.addEventListener("input",function(){


        let value=this.value
        .trim()
        .toLowerCase();



        let count=0;



        doctors.forEach(item=>{


        let name=item.dataset.name || "";

        let phone=item.dataset.phone || "";

        let number=item.dataset.number || "";



        if(
        name.includes(value) ||
        phone.includes(value) ||
        number.includes(value)
        )

        {

        item.style.display="";
        count++;

        }

        else

        {

        item.style.display="none";

        }


        });



        resultCount.innerText=count;


        });




        clearButton.addEventListener("click",function(){


        searchBox.value="";


        doctors.forEach(item=>{

        item.style.display="";

        });



        resultCount.innerText=
        doctors.length;


        });
              // =======================
        // الأوامر الصوتية
        // =======================

        const voiceButton =
            document.getElementById("voiceButton");
            console.log("زر الصوت:", voiceButton);
                    console.log(voiceButton);
        const voiceResult =
            document.getElementById("voiceResult");


        // =======================
        // دالة النطق
        // =======================

        function speak(message)
        {
            voiceResult.style.display = "block";

            voiceResult.innerHTML = message;


            let speech =
            new SpeechSynthesisUtterance(message);


            speech.lang = "ar-JO";


            window.speechSynthesis.speak(speech);
        }




        if (voiceButton && voiceResult)
        {

            const SpeechRecognition =
                window.SpeechRecognition ||
                window.webkitSpeechRecognition;



            if (SpeechRecognition)
            {


                const recognition =
                new SpeechRecognition();



                recognition.lang = "ar-JO";

                recognition.continuous = false;

                recognition.interimResults = false;




                voiceButton.onclick = function()
                {


                    voiceResult.style.display = "block";


                    voiceResult.innerHTML =
                    "🎤 استمع الآن...";


                    recognition.start();


                };





                recognition.onresult = function(event)
                {


                    let text =
                    event.results[0][0].transcript
                    .trim()
                    .replace(/[.,،.]/g,"");



                    voiceResult.innerHTML =
                    "قلت: " + text;




                    // =======================
                    // عدد الأطباء
                    // =======================


                    if(
                    text.includes("كم عدد الأطباء") ||
                    text.includes("عدد الأطباء"))
                    {


                        let count =
                        document.querySelectorAll(".doctor-item").length;



                        speak(
                        "عدد الأطباء هو " + count
                        );


                        return;

                    }





                    // =======================
                    // عدد الأقسام
                    // =======================

        else if(
        text.includes("كم عدد الأقسام") ||
        text.includes("عدد الأقسام"))
        {


           let count = 0;



            speak(
            "عدد الأقسام هو " + count
            );


            return;

        }





                            // =======================
        // كم طبيب في قسم
        // =======================

        else if(
            text.includes("كم طبيب في") ||
            text.includes("كم عدد الأطباء في") ||
            text.includes("عدد أطباء")
        )
        {

            let department="";


            if(text.includes("الجراحة"))
                department="الجراحة";

            else if(text.includes("الباطني"))
                department="الباطني";

            else if(text.includes("الأطفال"))
                department="الأطفال";

            else if(text.includes("النسائية") || text.includes("نساء"))
                department="النسائية";

            else if(text.includes("الاختياري"))
                department="الاختياري";

            else if(text.includes("الطوارئ"))
                department="الطوارئ";



            if(department!="")
            {


                let index =
                departmentLabels.indexOf(department);



                if(index !== -1)
                {

                    let count =
                    departmentCounts[index];


                    speak(
                    "عدد أطباء قسم "
                    + department
                    + " هو "
                    + count
                    );


                }
                else
                {

                    speak(
                    "لم أجد هذا القسم"
                    );

                }


            }
            else
            {

                speak(
                "اذكر اسم القسم"
                );

            }


            return;

        }



                    // =======================
                    // الأطباء القريب انتهاء تدريبهم
                    // =======================


                    else if(
                    text.includes("ينتهي تدريبه") ||
                    text.includes("قريب انتهاء التدريب"))
                    {


                        let names=[];



                        document
                        .querySelectorAll(".doctor-item")
                        .forEach(function(item)
                        {


                            let alert =
                            item.querySelector(".badge.bg-danger");



                            if(alert)
                            {

                                names.push(
                                item.querySelector("td:nth-child(2)").innerText
                                );

                            }


                        });




                        if(names.length>0)
                        {

                            speak(
                            "الأطباء القريب انتهاء تدريبهم: "
                            + names.join(" ، ")
                            );


                        }
                        else
                        {

                            speak(
                            "لا يوجد أطباء قريب انتهاء تدريبهم"
                            );

                        }



                        return;


                    }
                    // =======================
                    // البحث باسم الطبيب
                    // =======================

                    else if(text.includes("ابحث"))
                    {

                        let name =
                        text.replace("ابحث عن","")
                        .replace("ابحث","")
                        .trim();


                        document.getElementById("doctorSearch").value = name;


                        document.getElementById("doctorSearch")
                        .dispatchEvent(new Event("input"));


                        return;

                    }




                    // =======================
                    // فتح ملف الطبيب بالصوت
                    // مثال: افتح ملف الطبيب أحمد
                    // =======================


                    else if(text.includes("افتح ملف الطبيب"))
                    {


                        let doctorName =
                        text.replace("افتح ملف الطبيب","")
                        .trim();



                        let found=false;



                        document.querySelectorAll(".doctor-item")
                        .forEach(function(item)
                        {


                            let name =
                            item.dataset.name || "";



                            if(name.includes(doctorName.toLowerCase()))
                            {


                                let detailsButton =
                                item.querySelector('a[href*="Details"]');



                                if(detailsButton)
                                {

                                    window.location.href =
                                    detailsButton.href;


                                    found=true;

                                }


                            }


                        });




                        if(!found)
                        {

                            speak(
                            "لم أجد الطبيب " + doctorName
                            );

                        }


                        return;


                    }





                    // =======================
                    // مسح البحث
                    // =======================


                    else if(text.includes("مسح البحث"))
                    {

                        document
                        .getElementById("clearSearch")
                        .click();


                        return;

                    }





                    // =======================
                    // الانتقال للأقسام
                    // =======================


                    else if(text.includes("الجراحة"))
                    {

                        window.location.href =
                        "/Doctors/DepartmentDoctors?name="
                        + encodeURIComponent("الجراحة");


                    }



                    else if(text.includes("الأطفال"))
                    {

                        window.location.href =
                        "/Doctors/DepartmentDoctors?name="
                        + encodeURIComponent("الأطفال");


                    }



                    else if(text.includes("النسائية") ||
                            text.includes("نساء"))
                    {

                        window.location.href =
                        "/Doctors/DepartmentDoctors?name="
                        + encodeURIComponent("النسائية");


                    }




                    else if(text.includes("الباطني") ||
                            text.includes("باطنة"))
                    {

                        window.location.href =
                        "/Doctors/DepartmentDoctors?name="
                        + encodeURIComponent("الباطني");


                    }




                    else if(text.includes("الطوارئ") ||
                            text.includes("طوارئ"))
                    {

                        window.location.href =
                        "/Doctors/DepartmentDoctors?name="
                        + encodeURIComponent("الطوارئ");


                    }




                    else if(text.includes("التخدير"))
                    {

                        window.location.href =
                        "/Doctors/DepartmentDoctors?name="
                        + encodeURIComponent("التخدير");


                    }




                    else if(text.includes("العيون"))
                    {

                        window.location.href =
                        "/Doctors/DepartmentDoctors?name="
                        + encodeURIComponent("العيون");


                    }




                    else if(text.includes("الأذن") ||
                            text.includes("الأنف"))
                    {

                        window.location.href =
                        "/Doctors/DepartmentDoctors?name="
                        + encodeURIComponent("الأنف والأذن");


                    }




                    // =======================
                    // أوامر الصفحات
                    // =======================


                    else if(text.includes("إضافة طبيب") ||
                            text.includes("اضافة طبيب"))
                    {

                        window.location.href =
                        "/Doctors/Create";


                    }



                    else if(text.includes("نسخة احتياطية") ||
                            text.includes("نسخة"))
                    {

                        window.location.href =
                        "/Backup/Download";


                    }




                    else if(text.includes("استيراد") ||
                            text.includes("أكسس"))
                    {

                        window.location.href =
                        "/Import/Access";


                    }




                    else if(text.includes("الرئيسية"))
                    {

                        window.location.href =
                        "/";


                    }




                    else
                    {

                        speak("لم أفهم الأمر");

                    }



                };





                recognition.onerror = function()
                {

                    voiceResult.innerHTML =
                    "لم يتم التعرف على الصوت";

                };



            }

            else
            {

                voiceButton.disabled=true;


                voiceResult.innerHTML =
                "المتصفح لا يدعم الأوامر الصوتية";

            }


        }
    </script>


    </main>
</div>