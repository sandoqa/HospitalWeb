@model IEnumerable<HospitalWeb.Models.Doctor>

@{
    ViewData["Title"] = "الأطباء";

    var doctors = Model ?? Enumerable.Empty<HospitalWeb.Models.Doctor>();

    var warningDays =
        ViewBag.WarningDays as Dictionary<int, int>
        ?? new Dictionary<int, int>();
}


<div class="container-fluid" dir="rtl">


<h1 class="text-center mb-4">
    قائمة الأطباء
</h1>


<h5 class="text-primary text-center">
    عدد الأطباء:
    <span id="resultCount">
        @doctors.Count()
    </span>
</h5>



@if (warningDays.Any())
{
    <div class="alert alert-danger text-center">
        يوجد @warningDays.Count طبيب قريب من انتهاء الروتيشن
    </div>
}





<!-- البحث -->

<div class="row mb-3">

    <div class="col-md-6">

        <div class="input-group">

            <input type="text"
                   id="doctorSearch"
                   class="form-control"
                   placeholder="🔍 ابحث باسم الطبيب أو الرقم..." />


            <button id="clearSearch"
                    type="button"
                    class="btn btn-secondary">
                مسح
            </button>

        </div>

    </div>



    <div class="col-md-6 text-center text-md-end">


        <a asp-action="Create"
           class="btn btn-success mb-2">
            + إضافة طبيب
                <a asp-controller="Backup"
                   asp-action="Download"
                   class="btn btn-success">
                    📥 تحميل نسخة احتياطية
                </a>

        </a>



        <a asp-controller="Import"
           asp-action="Access"
           class="btn btn-dark mb-2">
            📥 استيراد Access
        </a>


    </div>

</div>





<!-- جدول الأطباء -->


<div class="table-responsive">


<table class="table table-bordered table-striped text-center align-middle">



<thead class="table-dark">

<tr>

<th>الصورة</th>
<th>الاسم</th>
<th>رقم الطبيب</th>
<th>الجامعة</th>
<th>سنة التخرج</th>
<th>الهاتف</th>
<th>التنبيه</th>
<th>التدريبات</th>
<th>الإجراءات</th>

</tr>

</thead>


<tbody>



@foreach (var item in doctors)
{

    warningDays.TryGetValue(item.Id, out int days);


                    var alertClass = days switch
                    {
                        1 => "danger-blink",
                        2 => "orange-blink",
                        3 => "yellow-blink",
                        4 => "blue-blink",
                        5 => "green-blink",
                        _ => ""
                    };
                   

    <tr class="@alertClass doctor-item"
        data-name="@item.الاسم.ToLower()"
        data-phone="@item.Phone"
        data-number="@item.رقم_الطبيب">
                        <td>

                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@item.ImagePath"
                                     class="doctor-img" />
                            }
                            else
                            {
                                <span class="text-muted">
                                    لا توجد صورة
                                </span>
                            }

                        </td>



                        <td>
                            @item.الاسم
                        </td>



                        <td>
                            @item.رقم_الطبيب
                        </td>



                        <td>
                            @item.الجامعة
                        </td>



                        <td>
                            @item.سنة_التخرج
                        </td>



                        <td>
                            @item.Phone
                        </td>



                        <td>

                            @if (days > 0)
                            {
                                <span class="badge bg-danger">
                                    باقي @days يوم
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    طبيعي
                                </span>
                            }

                        </td>




                        <td>

                            @if (item.TrainingRotations != null &&
                                                    item.TrainingRotations.Any())
                            {
                                <span class="badge bg-primary">
                                    @item.TrainingRotations.Count تدريب
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    لا يوجد
                                </span>
                            }

                        </td>




                        <td>


                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm">
                                ملف
                            </a>



                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                تعديل
                            </a>



                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm">
                                حذف
                            </a>
                            <a asp-action="TrainingNotice"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-sm">
                                📄 إشعار تدريب
                            </a>
                            <a asp-action="InternshipFinish"
                               asp-route-id="@item.Id"
                               class="btn btn-success btn-sm">
                                📄 إنهاء امتياز
                            </a>
                            <a asp-action="DepartmentAssignment"
                               asp-route-id="@item.Id"
                               class="btn btn-secondary btn-sm">
                                📄 تحديد قسم
                            </a>
                        </td>


                    </tr>


                }


            </tbody>


        </table>


    </div>
    <style>

        body {
            overflow-x: hidden;
        }


        /* صورة الطبيب */

        .doctor-img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 10px;
        }



        /* ======================
           وميض التنبيهات
        ====================== */


        tr.danger-blink td {
            animation: redBlink 1s infinite;
        }


        tr.orange-blink td {
            animation: orangeBlink 1s infinite;
        }


        tr.yellow-blink td {
            animation: yellowBlink 1s infinite;
        }


        tr.blue-blink td {
            animation: blueBlink 1s infinite;
        }


        tr.green-blink td {
            animation: greenBlink 1s infinite;
        }



        @@keyframes redBlink {

            0%, 100% {
                background: red;
                color: white;
            }

            50% {
                background: white;
                color: black;
            }
        }



        @@keyframes orangeBlink {

            0%, 100% {
                background: #ff9900;
            }

            50% {
                background: white;
            }
        }



        @@keyframes yellowBlink {

            0%, 100% {
                background: #ffff66;
            }

            50% {
                background: white;
            }
        }



        @@keyframes blueBlink {

            0%, 100% {
                background: #3399ff;
                color: white;
            }

            50% {
                background: white;
                color: black;
            }
        }



        @@keyframes greenBlink {

            0%, 100% {
                background: #33cc66;
                color: white;
            }

            50% {
                background: white;
                color: black;
            }
        }

    </style>





    <script>


        const searchBox =
            document.getElementById("doctorSearch");


        const clearButton =
            document.getElementById("clearSearch");


        const doctors =
            document.querySelectorAll(".doctor-item");


        const resultCount =
            document.getElementById("resultCount");





        searchBox.addEventListener("input", function(){


            let value =
                this.value.trim().toLowerCase();


            let count = 0;



            doctors.forEach(item => {



                let name =
                    item.dataset.name || "";


                let phone =
                    item.dataset.phone || "";


                let number =
                    item.dataset.number || "";



                if(
                    name.includes(value) ||
                    phone.includes(value) ||
                    number.includes(value)
                )

                {

                    item.style.display="";

                    count++;

                }

                else

                {

                    item.style.display="none";

                }



            });



            resultCount.innerText=count;


        });






        clearButton.addEventListener("click",function(){


            searchBox.value="";


            doctors.forEach(item=>{

                item.style.display="";

            });



            resultCount.innerText =
                doctors.length;


        });



    </script>


</div>