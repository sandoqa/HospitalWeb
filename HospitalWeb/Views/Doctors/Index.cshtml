@model IEnumerable<HospitalWeb.Models.Doctor>

@{
    ViewData["Title"] = "الأطباء";

    var doctors = Model ?? Enumerable.Empty<HospitalWeb.Models.Doctor>();

    var warningDays =
        ViewBag.WarningDays as Dictionary<int, int>
        ?? new Dictionary<int, int>();
}


<div class="container-fluid" dir="rtl">


<h1 class="text-center mb-4">
    قائمة الأطباء
</h1>


<h5 class="text-primary text-center">
    عدد الأطباء:
    <span id="resultCount">
        @doctors.Count()
    </span>
</h5>



@if (warningDays.Any())
{
    <div class="alert alert-danger text-center">
        يوجد @warningDays.Count طبيب قريب من انتهاء الروتيشن
    </div>
}





<!-- البحث -->

<div class="row mb-3">

    <div class="col-12 col-md-6 mb-2">

        <div class="input-group">

            <input type="text"
                   id="doctorSearch"
                   class="form-control"
                   placeholder="🔍 ابحث باسم الطبيب أو الرقم..." />


            <button id="clearSearch"
                    type="button"
                    class="btn btn-secondary">
                مسح
            </button>


        </div>

    </div>




    <div class="col-12 col-md-6 text-center text-md-end">


        <a asp-action="Create"
           class="btn btn-success mb-2">
            + إضافة طبيب
        </a>



        <a asp-controller="Import"
           asp-action="Access"
           class="btn btn-dark mb-2">
            📥 استيراد Access
        </a>


    </div>


</div>





<!-- ===========================
     نسخة الكمبيوتر
=========================== -->


<div class="table-responsive desktop-view">


<table class="table table-bordered table-striped text-center align-middle">



<thead class="table-dark">

<tr>

<th>الصورة</th>
<th>الاسم</th>
<th>رقم الطبيب</th>
<th>الجامعة</th>
<th>سنة التخرج</th>
<th>الهاتف</th>
<th>التنبيه</th>
<th>التدريبات</th>
<th>الإجراءات</th>

</tr>

</thead>



<tbody>


@foreach (var item in doctors)
{

    warningDays.TryGetValue(item.Id, out int days);



    <tr class="doctor-item"
        data-name="@item.الاسم.ToLower()"
        data-phone="@item.Phone"
        data-number="@item.رقم_الطبيب">



        <td>

        @if (!string.IsNullOrEmpty(item.ImagePath))
        {
            <img src="@item.ImagePath"
                 class="doctor-img" />
        }
        else
        {
            <span class="text-muted">
                لا توجد صورة
            </span>
        }

        </td>



        <td>
            @item.الاسم
        </td>



        <td>
            @item.رقم_الطبيب
        </td>



        <td>
            @item.الجامعة
        </td>



        <td>
            @item.سنة_التخرج
        </td>



        <td>
            @item.Phone
        </td>
                        <td>

                            @if (days > 0)
                            {
                                <span class="badge bg-danger">
                                    باقي @days يوم
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    طبيعي
                                </span>
                            }

                        </td>



                        <td>

                            @if (item.TrainingRotations != null &&
                                                    item.TrainingRotations.Any())
                            {
                                <span class="badge bg-primary">
                                    @item.TrainingRotations.Count تدريب
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    لا يوجد
                                </span>
                            }

                        </td>



                        <td>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm">
                                ملف
                            </a>


                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                تعديل
                            </a>


                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-danger btn-sm">
                                حذف
                            </a>

                        </td>



                    </tr>

                }


            </tbody>


        </table>


    </div>





    <!-- ===========================
         نسخة الهاتف (بطاقات)
    =========================== -->


    <div class="mobile-view">


        @foreach (var item in doctors)
        {

            warningDays.TryGetValue(item.Id, out int days);


            <div class="doctor-card doctor-item"
                 data-name="@item.الاسم.ToLower()"
                 data-phone="@item.Phone"
                 data-number="@item.رقم_الطبيب">



                @if (!string.IsNullOrEmpty(item.ImagePath))
                {
                    <img src="@item.ImagePath"
                         class="doctor-card-img" />
                }
                else
                {
                    <div class="no-image">
                        لا توجد صورة
                    </div>
                }



                <h4>
                    @item.الاسم
                </h4>



                <p>
                    <b>رقم الطبيب:</b>
                    @item.رقم_الطبيب
                </p>


                <p>
                    <b>الهاتف:</b>
                    @item.Phone
                </p>


                <p>
                    <b>الجامعة:</b>
                    @item.الجامعة
                </p>


                <p>
                    <b>سنة التخرج:</b>
                    @item.سنة_التخرج
                </p>



                @if (days > 0)
                {
                    <span class="badge bg-danger">
                        باقي @days يوم
                    </span>
                }
                else
                {
                    <span class="badge bg-success">
                        طبيعي
                    </span>
                }



                <div class="mt-3">

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        ملف
                    </a>


                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        تعديل
                    </a>


                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        حذف
                    </a>

                </div>


            </div>


        }


    </div>
    <style>


        body {
            overflow-x: hidden;
        }


        /* صور الجدول */

        .doctor-img {
            width: 70px;
            height: 70px;
            object-fit: cover;
            border-radius: 10px;
        }




        /* بطاقات الهاتف */

        .mobile-view {
            display: none;
        }



        .doctor-card {
            background: white;
            border-radius: 15px;
            padding: 15px;
            margin-bottom: 15px;
            box-shadow: 0 2px 8px #ccc;
            text-align: center;
        }



        .doctor-card-img {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 50%;
            margin: auto;
            display: block;
        }



        .no-image {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: #ddd;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: auto;
        }



        .doctor-card .btn {
            margin: 3px;
        }



        /* تنبيه الروتيشن */

        tr.danger-blink {
            animation: redBlink 1s infinite;
        }


        tr.orange-blink {
            animation: orangeBlink 1s infinite;
        }


        tr.yellow-blink {
            animation: yellowBlink 1s infinite;
        }


        tr.blue-blink {
            animation: blueBlink 1s infinite;
        }


        tr.green-blink {
            animation: greenBlink 1s infinite;
        }




        @@keyframes redBlink {

            0%, 100% {
                background: red;
                color: white;
            }

            50% {
                background: white;
                color: black;
            }
        }



        @@keyframes orangeBlink {

            0%, 100% {
                background: #ff9900;
            }

            50% {
                background: white;
            }
        }



        @@keyframes yellowBlink {

            0%, 100% {
                background: #ffff66;
            }

            50% {
                background: white;
            }
        }



        @@keyframes blueBlink {

            0%, 100% {
                background: #3399ff;
                color: white;
            }

            50% {
                background: white;
                color: black;
            }
        }



        @@keyframes greenBlink {

            0%, 100% {
                background: #33cc66;
                color: white;
            }

            50% {
                background: white;
                color: black;
            }
        }






        /* شاشة الهاتف */

        @@media(max-width:768px) {


            .desktop-view {
                display: none;
            }



            .mobile-view {
                display: block;
            }



            h1 {
                font-size: 24px;
            }



            .btn {
                width: 100%;
                margin-bottom: 5px;
            }



            .input-group {
                flex-direction: column;
            }



            #doctorSearch {
                margin-bottom: 5px;
            }
        }






        /* شاشة الكمبيوتر */


        @@media(min-width:769px) {


            .desktop-view {
                display: block;
            }



            .mobile-view {
                display: none;
            }
        }

    </style>






    <script>


        // ===========================
        // Live Search
        // ===========================


        const searchBox =
            document.getElementById("doctorSearch");


        const clearButton =
            document.getElementById("clearSearch");


        const doctors =
            document.querySelectorAll(".doctor-item");


        const resultCount =
            document.getElementById("resultCount");





        searchBox.addEventListener("input", function(){


            let value =
                this.value.trim().toLowerCase();



            let count = 0;



            doctors.forEach(item => {



                let name =
                    item.dataset.name || "";



                let phone =
                    item.dataset.phone || "";



                let number =
                    item.dataset.number || "";




                if(

                    name.startsWith(value)
                    ||
                    phone.startsWith(value)
                    ||
                    number.startsWith(value)

                )

                {

                    item.style.display="";

                    count++;

                }

                else

                {

                    item.style.display="none";

                }



            });



            resultCount.innerText=count;


        });







        // زر المسح


        clearButton.addEventListener("click",function(){


            searchBox.value="";


            doctors.forEach(item=>{


                item.style.display="";


            });



            resultCount.innerText =
                doctors.length;


        });



    </script>


</div>