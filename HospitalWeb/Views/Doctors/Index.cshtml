@model IEnumerable<HospitalWeb.Models.Doctor>

@{
    ViewData["Title"] = "الأطباء";

    var doctors = Model ?? Enumerable.Empty<HospitalWeb.Models.Doctor>();

    var warningDays =
        ViewBag.WarningDays as Dictionary<int, int>
        ?? new Dictionary<int, int>();
}


<h1 class="mb-4">
    قائمة الأطباء
</h1>


<h5 class="text-primary">
    عدد الأطباء:
    <span id="resultCount">@doctors.Count()</span>
</h5>



@if (warningDays.Any())
{
    <div class="alert alert-danger">
        يوجد @warningDays.Count طبيب قريب من انتهاء الروتيشن
    </div>
}



<div class="row mb-3">


    <div class="col-md-6">


        <div class="input-group">


            <input type="text"
                   id="doctorSearch"
                   class="form-control"
                   placeholder="اكتب بداية اسم الطبيب..." />


            <button id="clearSearch"
                    class="btn btn-secondary"
                    type="button">
                مسح
            </button>


        </div>


    </div>




    <div class="col-md-6 text-end">


        <a asp-action="Create"
           class="btn btn-success">
            + إضافة طبيب جديد
        </a>



        <a asp-controller="Import"
           asp-action="Access"
           class="btn btn-dark">
            📥 استيراد بيانات Access
        </a>


    </div>


</div>





<table class="table table-bordered table-striped text-center align-middle">


    <thead class="table-dark">

        <tr>

            <th>الصورة</th>
            <th>الاسم</th>
            <th>رقم الطبيب</th>
            <th>الجامعة</th>
            <th>سنة التخرج</th>
            <th>الهاتف</th>
            <th>التنبيه</th>
            <th>التدريبات</th>
            <th>الإجراءات</th>

        </tr>

    </thead>



    <tbody>



        @foreach (var item in doctors)
        {

            warningDays.TryGetValue(item.Id, out int days);


            string rowClass = days switch
            {
                1 => "danger-blink",
                2 => "orange-blink",
                3 => "yellow-blink",
                4 => "blue-blink",
                5 => "green-blink",
                _ => ""
            };



            <tr class="@rowClass doctor-row"
                data-name="@item.الاسم.ToLower()"
                data-phone="@item.Phone"
                data-number="@item.رقم_الطبيب">


                <td>


                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath"
                             width="70"
                             height="70"
                             style="object-fit:cover;border-radius:5px" />
                    }
                    else
                    {
                        <span class="text-muted">
                            لا توجد صورة
                        </span>
                    }


                </td>




                <td>
                    @item.الاسم
                </td>



                <td>
                    @item.رقم_الطبيب
                </td>



                <td>
                    @item.الجامعة
                </td>



                <td>
                    @item.سنة_التخرج
                </td>



                <td>
                    @item.Phone
                </td>




                <td>

                    @if (days > 0)
                    {
                        <span class="badge bg-danger">
                            باقي @days يوم
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success">
                            طبيعي
                        </span>
                    }

                </td>




                <td>

                    @if (item.TrainingRotations != null &&
                                    item.TrainingRotations.Any())
                    {
                        <span class="badge bg-primary">
                            @item.TrainingRotations.Count تدريب
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            لا يوجد
                        </span>
                    }

                </td>




                <td>


                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        ملف الطبيب
                    </a>


                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        تعديل
                    </a>


                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        حذف
                    </a>


                </td>



            </tr>


        }



    </tbody>


</table>







<style>


    .table > tbody > tr.danger-blink > *,
    .table > tbody > tr.orange-blink > *,
    .table > tbody > tr.yellow-blink > *,
    .table > tbody > tr.blue-blink > *,
    .table > tbody > tr.green-blink > * {
        background-color: transparent !important;
    }



    tr.danger-blink {
        animation: redBlink 1s infinite;
        font-weight: bold;
    }



    tr.orange-blink {
        animation: orangeBlink 1s infinite;
        font-weight: bold;
    }



    tr.yellow-blink {
        animation: yellowBlink 1s infinite;
        font-weight: bold;
    }



    tr.blue-blink {
        animation: blueBlink 1s infinite;
        font-weight: bold;
    }



    tr.green-blink {
        animation: greenBlink 1s infinite;
        font-weight: bold;
    }





    @@keyframes redBlink {
        0%, 100% {
            background: red;
            color: white;
        }

        50% {
            background: white;
            color: black;
        }
    }




    @@keyframes orangeBlink {
        0%, 100% {
            background: #ff9900;
        }

        50% {
            background: white;
        }
    }




    @@keyframes yellowBlink {
        0%, 100% {
            background: #ffff66;
        }

        50% {
            background: white;
        }
    }




    @@keyframes blueBlink {
        0%, 100% {
            background: #3399ff;
            color: white;
        }

        50% {
            background: white;
            color: black;
        }
    }




    @@keyframes greenBlink {
        0%, 100% {
            background: #33cc66;
            color: white;
        }

        50% {
            background: white;
            color: black;
        }
    }

</style>





<script>


    const searchBox =
        document.getElementById("doctorSearch");


    const clearButton =
        document.getElementById("clearSearch");


    const rows =
        document.querySelectorAll(".doctor-row");


    const resultCount =
        document.getElementById("resultCount");




    searchBox.addEventListener("input", function(){


        let value =
            this.value.trim().toLowerCase();



        let count = 0;



        rows.forEach(row => {


            let name =
                row.dataset.name || "";


            let phone =
                row.dataset.phone || "";


            let number =
                row.dataset.number || "";



            if(
                name.startsWith(value) ||
                phone.startsWith(value) ||
                number.startsWith(value)
            )
            {

                row.style.display="";
                count++;

            }
            else
            {

                row.style.display="none";

            }



        });



        resultCount.innerText=count;


    });





    clearButton.addEventListener("click",function(){


        searchBox.value="";


        rows.forEach(row=>{

            row.style.display="";

        });



        resultCount.innerText=rows.length;


    });



</script>