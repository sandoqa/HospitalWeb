```cshtml
@model IEnumerable<HospitalWeb.Models.Doctor>

@{
    ViewData["Title"] = "أطباء القسم";

    var doctors = Model ?? Enumerable.Empty<HospitalWeb.Models.Doctor>();

    var warningDays =
        ViewBag.WarningDays as Dictionary<int, int>
        ?? new Dictionary<int, int>();
}


<div class="container-fluid mt-4" dir="rtl">

    <h2 class="text-center text-primary mb-3">

        👨‍⚕️ أطباء قسم @ViewBag.DepartmentName

    </h2>


    <h5 class="text-center mb-4">

        عدد الأطباء الحاليين:
        <strong>@doctors.Count()</strong>

    </h5>


    <div class="table-responsive shadow-sm">

        <table class="table table-bordered table-striped text-center align-middle">

            <thead class="table-dark">

                <tr>

                    <th>الصورة</th>

                    <th>الاسم</th>

                    <th>رقم الطبيب</th>

                    <th>الهاتف</th>

                    <th>التنبيه</th>

                    <th>التدريبات</th>

                    <th>الملف</th>

                </tr>

            </thead>


            <tbody>

                @foreach (var doctor in doctors)
                {
                    warningDays.TryGetValue(
                    doctor.Id,
                    out int days
                    );


                    // =========================
                    // نوع الوميض حسب الأيام
                    // =========================

                    var alertClass = days switch
                    {
                        1 => "danger-blink",
                        2 => "orange-blink",
                        3 => "yellow-blink",
                        4 => "blue-blink",
                        5 => "green-blink",
                        _ => ""
                    };


                    // =========================
                    // حالة الروتيشن السادس
                    // =========================

                    bool internshipEnding = false;

                    bool finishedInternship = false;


                    if (doctor.TrainingRotations != null &&
                    doctor.TrainingRotations.Count == 6)
                    {
                        var lastRotation =
                        doctor.TrainingRotations
                        .OrderBy(x => x.StartDate)
                        .LastOrDefault();


                        if (lastRotation != null)
                        {
                            if (lastRotation.EndDate >= DateTime.Today)
                            {
                                internshipEnding = true;
                            }

                            if (lastRotation.EndDate < DateTime.Today)
                            {
                                finishedInternship = true;
                            }
                        }
                    }


                    // =========================
                    // تحديد لون الصف
                    // =========================

                    var rowClass =
                    finishedInternship
                    ? "internship-black"
                    :
                    internshipEnding
                    ? "internship-progress"
                    :
                    alertClass;


                    <tr class="@rowClass">

                        <td>

                            @if (!string.IsNullOrEmpty(doctor.ImagePath))
                            {
                                <img src="@doctor.ImagePath"
                                     class="doctor-img" />
                            }
                            else
                            {
                                <span class="text-muted">
                                    لا توجد صورة
                                </span>
                            }

                        </td>


                        <td>
                            @doctor.الاسم
                        </td>


                        <td>
                            @doctor.رقم_الطبيب
                        </td>


                        <td>
                            @doctor.Phone
                        </td>


                        <td>

                            @if (days > 0)
                            {
                                <span class="badge bg-danger">
                                    باقي @days يوم
                                </span>
                            }
                            else if (internshipEnding)
                            {
                                <span class="badge bg-success">
                                    الروتيشن السادس
                                </span>
                            }
                            else if (finishedInternship)
                            {
                                <span class="badge bg-dark">
                                    أنهى الامتياز
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    طبيعي
                                </span>
                            }

                        </td>


                        <td>

                            @if (doctor.TrainingRotations != null &&
                                                    doctor.TrainingRotations.Any())
                            {
                                <span class="badge bg-primary">

                                    @doctor.TrainingRotations.Count تدريب

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">

                                    لا يوجد

                                </span>
                            }

                        </td>


                        <td>

                            <a asp-action="Details"
                               asp-route-id="@doctor.Id"
                               class="btn btn-info btn-sm">

                                ملف

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <div class="text-center mt-4">

        <a asp-action="Index"
           class="btn btn-secondary">

            ⬅ رجوع

        </a>

    </div>

</div>


<style>

    /* =========================
           صورة الطبيب
           ========================= */

    .doctor-img {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 50%;
    }


    /* =========================
           الروتيشن السادس
           ========================= */

    tr.internship-progress td {
        background: linear-gradient( to right, #198754, #20c997 );
        background-size: 0% 100%;
        background-repeat: no-repeat;
        animation: fillTraining 3s linear infinite;
        color: white !important;
        font-weight: bold;
    }


    @@keyframes fillTraining {

        0% {
            background-size: 0% 100%;
        }

        50% {
            background-size: 100% 100%;
        }

        100% {
            background-size: 0% 100%;
        }
    }


    /* =========================
           أنهى سنة الامتياز
           ========================= */

    tr.internship-black td {
        background: #000 !important;
        color: #fff !important;
    }


    tr.internship-black a {
        color: white !important;
    }


    tr.internship-black .btn {
        border-color: white;
    }


    /* =========================
           أنواع التنبيه
           ========================= */

    tr.danger-blink td {
        animation: redBlink 1s infinite;
    }


    tr.orange-blink td {
        animation: orangeBlink 1s infinite;
    }


    tr.yellow-blink td {
        animation: yellowBlink 1s infinite;
    }


    tr.blue-blink td {
        animation: blueBlink 1s infinite;
    }


    tr.green-blink td {
        animation: greenBlink 1s infinite;
    }


    /* =========================
           الأحمر - باقي يوم
           ========================= */

    @@keyframes redBlink {

        0%, 100% {
            background: red;
            color: white;
        }

        50% {
            background: white;
            color: black;
        }
    }


    /* =========================
           البرتقالي - باقي يومين
           ========================= */

    @@keyframes orangeBlink {

        0%, 100% {
            background: #ff9900;
        }

        50% {
            background: white;
        }
    }


    /* =========================
           الأصفر - باقي 3 أيام
           ========================= */

    @@keyframes yellowBlink {

        0%, 100% {
            background: #ffff66;
        }

        50% {
            background: white;
        }
    }


    /* =========================
           الأزرق - باقي 4 أيام
           ========================= */

    @@keyframes blueBlink {

        0%, 100% {
            background: #3399ff;
            color: white;
        }

        50% {
            background: white;
            color: black;
        }
    }


    /* =========================
           الأخضر - باقي 5 أيام
           ========================= */

    @@keyframes greenBlink {

        0%, 100% {
            background: #33cc66;
            color: white;
        }

        50% {
            background: white;
            color: black;
        }
    }


    @@media(max-width:768px) {

        .table {
            min-width: 900px;
            font-size: 12px;
        }

        .btn-sm {
            font-size: 11px;
            padding: 3px 6px;
        }
    }

</style>
```
