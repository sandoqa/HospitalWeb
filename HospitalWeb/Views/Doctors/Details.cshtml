@model HospitalWeb.Models.Doctor

@{
    ViewData["Title"] = "ملف الطبيب";
}



<div class="print-header">

    <img src="/images/OIP.webp"
         class="hospital-logo" />

    <h2>
        مستشفى البشير
    </h2>

    <h4>
        مديرية التدريب والتعليم الطبي
    </h4>

    <hr />

    <h3>
        سجل تدريب الطبيب
    </h3>

</div>




<h1 class="no-print">
    ملف الطبيب
</h1>



<hr class="no-print" />





<div class="row">


    <div class="col-md-3 no-print">


        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {

            <img src="@Model.ImagePath"
                 class="img-thumbnail doctor-image" />

        }
        else
        {

            <p>
                لا توجد صورة
            </p>

        }


    </div>





    <div class="col-md-9">


        <dl class="row">


            <dt class="col-sm-3">
                الاسم
            </dt>

            <dd class="col-sm-9">
                @Model.الاسم
            </dd>




            <dt class="col-sm-3">
                رقم الطبيب
            </dt>

            <dd class="col-sm-9">
                @Model.رقم_الطبيب
            </dd>




            <dt class="col-sm-3">
                الهاتف
            </dt>

            <dd class="col-sm-9">
                @Model.Phone
            </dd>




            <dt class="col-sm-3">
                الجامعة
            </dt>

            <dd class="col-sm-9">
                @Model.الجامعة
            </dd>




            <dt class="col-sm-3">
                سنة التخرج
            </dt>

            <dd class="col-sm-9">
                @Model.سنة_التخرج
            </dd>


        </dl>


    </div>


</div>





<hr />


<h3>
    سجل التدريب
</h3>




@{

    var departments = new[]
    {
        "الجراحة",
        "الباطني",
        "النسائية",
        "الأطفال",
        "الطوارئ",
        "الاختياري"
    };


    var today = DateTime.Today;

}





<table class="table table-bordered text-center align-middle">


    <thead class="table-dark">

        <tr>

            <th>
                القسم
            </th>


            <th>
                بداية التدريب
            </th>


            <th>
                نهاية التدريب
            </th>


            <th>
                الحالة
            </th>


            <th class="no-print">
                الإجراءات
            </th>


        </tr>

    </thead>




    <tbody>



        @foreach (var dept in departments)
        {


            var training =
            Model.TrainingRotations?
            .FirstOrDefault(x =>
            x.Department != null &&
            x.Department.Name == dept);



            <tr>


                <td>

                    <strong>
                        @dept
                    </strong>

                </td>




                @if (training == null)
                {


                    <td>
                        -
                    </td>


                    <td>
                        -
                    </td>



                    <td>

                        <span class="text-danger fw-bold">

                            لم يبدأ التدريب بعد

                        </span>

                    </td>



                    <td class="no-print">

                        -

                    </td>


                }

                else
                {


                    var remaining =
                    (training.EndDate.Date - today).Days;


                    var future =
                    (training.StartDate.Date - today).Days;



                    <td>
                        @training.StartDate.ToString("dd/MM/yyyy")
                    </td>


                    <td>
                        @training.EndDate.ToString("dd/MM/yyyy")
                    </td>




                    <td>


                        @if (training.EndDate.Date < today)
                        {

                            <span class="text-success fw-bold">

                                تم التدريب

                            </span>

                        }

                        else if (training.StartDate.Date <= today)
                        {

                            <span class="text-primary fw-bold">

                                مستمر

                                <br />

                                باقي @remaining يوم

                            </span>

                        }

                        else
                        {

                            <span class="text-secondary fw-bold">

                                قادم

                                <br />

                                يبدأ بعد @future يوم

                            </span>

                        }


                    </td>




                    <td class="no-print">


                        <a asp-controller="TrainingRotations"
                           asp-action="Edit"
                           asp-route-id="@training.Id"
                           class="btn btn-warning btn-sm">

                            تعديل

                        </a>



                        <a asp-controller="TrainingRotations"
                           asp-action="Delete"
                           asp-route-id="@training.Id"
                           class="btn btn-danger btn-sm">

                            حذف

                        </a>


                    </td>


                }


            </tr>


        }



    </tbody>


</table>






<div class="mt-3 no-print">


    <button onclick="window.print()"
            class="btn btn-dark">

        🖨️ طباعة سجل التدريب

    </button>




    <a asp-controller="Doctors"
       asp-action="AddTraining"
       asp-route-id="@Model.Id"
       class="btn btn-success">

        إضافة تدريب جديد

    </a>




    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">

        تعديل بيانات الطبيب

    </a>




    <a asp-action="Index"
       class="btn btn-secondary">

        العودة للقائمة

    </a>



</div>







<style>


    .doctor-image {
        width: 220px;
        height: 220px;
        object-fit: cover;
        border-radius: 0;
    }



    .print-header {
        display: none;
    }



    @@media print {


        .no-print {
            display: none !important;
        }



        .print-header {
            display: block;
            text-align: center;
        }



        .hospital-logo {
            width: 120px;
            height: 120px;
        }



        table {
            width: 100%;
            border-collapse: collapse;
        }



        th, td {
            border: 1px solid black !important;
            padding: 8px;
        }
    }

</style>