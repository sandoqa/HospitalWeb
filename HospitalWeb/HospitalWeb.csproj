<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>

		<Nullable>enable</Nullable>

		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Compile Razor views during publish -->
		<RazorCompileOnBuild>true</RazorCompileOnBuild>
		<RazorCompileOnPublish>true</RazorCompileOnPublish>

	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Templates\WordFiles\اشعار تدريب.docx" />
	  <None Remove="Templates\WordFiles\انهاء امتياز.docx" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Templates\WordFiles\اشعار تدريب.docx">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Templates\WordFiles\انهاء امتياز.docx">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>


	<ItemGroup>

		<PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />

		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.18" />

		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.18" />


		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.18">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>
				runtime; build; native; contentfiles; analyzers; buildtransitive
			</IncludeAssets>
		</PackageReference>


		<PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="9.0.12" />


		<PackageReference Include="System.Data.OleDb" Version="10.0.10" />

	</ItemGroup>


	<ItemGroup>

		<Folder Include="App_Data\" />

		<Folder Include="wwwroot\images\doctors\" />

	</ItemGroup>


</Project>